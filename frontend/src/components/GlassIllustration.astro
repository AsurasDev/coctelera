---
interface Props {
  glassType: string;
  liquidColor?: string;
  liquid2?: string;
  garnish?: string;
  size?: number;
}

const { glassType, liquidColor = '#c97a1e', liquid2, garnish } = Astro.props;

const S = 6; // stroke width
const LC = liquidColor;
const L2 = liquid2 || liquidColor;

function rocksGlass() {
  return `
<svg viewBox="0 0 120 140" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round" stroke-linecap="round">
  <rect x="16" y="32" width="88" height="88" rx="2" fill="${LC}" stroke="#111" stroke-width="${S}"/>
  <rect x="16" y="32" width="88" height="28" fill="${LC}" opacity="0.7" stroke="none"/>
  <rect x="16" y="32" width="88" height="3" fill="rgba(255,255,255,0.4)" stroke="none"/>
  <!-- ice cubes -->
  <rect x="28" y="44" width="22" height="22" fill="rgba(255,255,255,0.55)" stroke="#111" stroke-width="3"/>
  <rect x="58" y="50" width="18" height="18" fill="rgba(255,255,255,0.45)" stroke="#111" stroke-width="3"/>
  <!-- glass outline -->
  <rect x="16" y="32" width="88" height="88" rx="2" fill="none" stroke="#111" stroke-width="${S}"/>
  <!-- base -->
  <rect x="8" y="118" width="104" height="8" fill="#111" stroke="#111" stroke-width="2"/>
</svg>`;
}

function highballGlass() {
  return `
<svg viewBox="0 0 100 160" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round">
  <rect x="14" y="16" width="72" height="124" rx="3" fill="${LC}" stroke="#111" stroke-width="${S}"/>
  <rect x="14" y="16" width="72" height="35" fill="${LC}" opacity="0.6" stroke="none"/>
  <rect x="14" y="16" width="72" height="3" fill="rgba(255,255,255,0.35)" stroke="none"/>
  <!-- bubbles -->
  <circle cx="38" cy="80" r="4" fill="rgba(255,255,255,0.5)" stroke="none"/>
  <circle cx="58" cy="100" r="3" fill="rgba(255,255,255,0.4)" stroke="none"/>
  <circle cx="45" cy="60" r="3" fill="rgba(255,255,255,0.4)" stroke="none"/>
  <rect x="14" y="16" width="72" height="124" rx="3" fill="none" stroke="#111" stroke-width="${S}"/>
  <rect x="6" y="138" width="88" height="8" fill="#111" stroke="#111" stroke-width="2"/>
</svg>`;
}

function coupeGlass() {
  return `
<svg viewBox="0 0 130 160" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round">
  <!-- bowl -->
  <path d="M14,30 Q14,98 65,98 Q116,98 116,30 Z" fill="${LC}" stroke="#111" stroke-width="${S}"/>
  <path d="M14,30 Q14,60 65,60 Q116,60 116,30 Z" fill="${LC}" opacity="0.5" stroke="none"/>
  <path d="M14,30 L116,30" stroke="rgba(255,255,255,0.4)" stroke-width="3" fill="none"/>
  <!-- stem -->
  <line x1="65" y1="98" x2="65" y2="140" stroke="#111" stroke-width="${S}"/>
  <!-- base -->
  <rect x="30" y="140" width="70" height="8" fill="#111" stroke="#111" stroke-width="2"/>
</svg>`;
}

function martiniGlass() {
  return `
<svg viewBox="0 0 130 160" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round">
  <path d="M10,22 L65,96 L120,22 Z" fill="${LC}" stroke="#111" stroke-width="${S}"/>
  <path d="M10,22 L65,52 L120,22 Z" fill="${LC}" opacity="0.5" stroke="none"/>
  <line x1="10" y1="22" x2="120" y2="22" stroke="rgba(255,255,255,0.35)" stroke-width="3"/>
  <line x1="65" y1="96" x2="65" y2="140" stroke="#111" stroke-width="${S}"/>
  <rect x="30" y="140" width="70" height="8" fill="#111" stroke="#111" stroke-width="2"/>
</svg>`;
}

function hurricaneGlass() {
  return `
<svg viewBox="0 0 110 170" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round">
  <!-- body curves outward -->
  <path d="M28,20 Q8,70 14,110 Q20,148 55,148 Q90,148 96,110 Q102,70 82,20 Z" fill="${LC}" stroke="#111" stroke-width="${S}"/>
  <path d="M28,20 Q8,60 16,80 Q82,80 94,60 Q82,20 28,20 Z" fill="${LC}" opacity="0.5" stroke="none"/>
  <path d="M28,20 Q55,26 82,20" stroke="rgba(255,255,255,0.35)" stroke-width="3" fill="none"/>
  <!-- base -->
  <rect x="20" y="148" width="70" height="8" fill="#111" stroke="#111" stroke-width="2"/>
</svg>`;
}

function wineGlass() {
  return `
<svg viewBox="0 0 120 170" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round">
  <ellipse cx="60" cy="75" rx="46" ry="52" fill="${LC}" stroke="#111" stroke-width="${S}"/>
  <ellipse cx="60" cy="55" rx="46" ry="30" fill="${LC}" opacity="0.5" stroke="none"/>
  <ellipse cx="60" cy="30" rx="44" ry="8" fill="rgba(255,255,255,0.3)" stroke="none"/>
  <line x1="60" y1="127" x2="60" y2="155" stroke="#111" stroke-width="${S}"/>
  <rect x="28" y="155" width="64" height="8" fill="#111" stroke="#111" stroke-width="2"/>
</svg>`;
}

function shotGlass() {
  return `
<svg viewBox="0 0 80 110" xmlns="http://www.w3.org/2000/svg" stroke-linejoin="round">
  <path d="M14,16 L20,86 L60,86 L66,16 Z" fill="${LC}" stroke="#111" stroke-width="${S}"/>
  <path d="M14,16 L20,40 L60,40 L66,16 Z" fill="${LC}" opacity="0.55" stroke="none"/>
  <line x1="14" y1="16" x2="66" y2="16" stroke="rgba(255,255,255,0.35)" stroke-width="3"/>
  <rect x="6" y="86" width="68" height="8" fill="#111" stroke="#111" stroke-width="2"/>
</svg>`;
}

function getGlassSVG() {
  switch (glassType) {
    case 'highball': return highballGlass();
    case 'coupe':    return coupeGlass();
    case 'martini':  return martiniGlass();
    case 'hurricane':return hurricaneGlass();
    case 'wine':     return wineGlass();
    case 'shot':     return shotGlass();
    default:         return rocksGlass(); // rocks
  }
}

const svgContent = getGlassSVG();
---
<div class="glass-wrap" set:html={svgContent} />

<style>
  .glass-wrap {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .glass-wrap :global(svg) {
    width: 78%;
    height: 88%;
    display: block;
    filter: drop-shadow(4px 4px 0 rgba(0,0,0,.18));
  }
</style>
