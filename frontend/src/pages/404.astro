---
import Layout from '../components/Layout.astro';
---

<Layout title="404 — No encontrado · Coctelera" description="Esta página no existe.">
  <div class="c-shell" style="min-height:80vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:var(--sm-space-8)">
    <div style="border:var(--sm-border-mega);padding:var(--sm-space-8) var(--sm-space-10);box-shadow:var(--sm-shadow-xl);background:var(--sm-color-surface)">
      <div style="font-family:var(--sm-font-display);font-size:120px;line-height:.85;letter-spacing:var(--sm-track-tight);color:var(--sm-color-primary)">404</div>
      <h1 style="font-size:var(--sm-text-2xl);margin-top:var(--sm-space-4)">Cóctel no encontrado</h1>
      <p style="color:var(--sm-color-fg-muted);font-family:var(--sm-font-mono);font-size:var(--sm-text-2xs);letter-spacing:var(--sm-track-caps);text-transform:uppercase;margin-top:var(--sm-space-3)">
        Esta receta no existe en nuestra barra
      </p>
    </div>
    <a href="/" class="c-back" style="font-size:var(--sm-text-md)">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M12 5l-5 5 5 5"/>
      </svg>
      Volver a la galería
    </a>
  </div>
</Layout>
